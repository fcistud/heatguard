# Example Terraform resources mirroring infra/monitoring/policies.yaml.
# Apply in a project that already has notification channels; do not commit secrets.
#
#   terraform init && terraform plan
#
# Prefer keeping policies.yaml as the reviewable source of truth and generating
# or hand-synchronizing these resources from it.

terraform {
  required_version = ">= 1.5"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = ">= 5.0"
    }
  }
}

